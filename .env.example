# Local development only. This file contains paths, not credentials.
# The binary does not load .env automatically; export these variables first.
APOLLO_EDGE_LISTEN=127.0.0.1:8443
APOLLO_EDGE_CONTROL_LISTEN=127.0.0.1:9443
APOLLO_EDGE_GATEWAY_ID=gateway-local
APOLLO_EDGE_STATE_PATH=./var/gateway.state
APOLLO_EDGE_CERTIFICATE_MATERIAL_DIR=./var/certificates
APOLLO_EDGE_CONTROL_CA=./secrets/control-ca.pem
APOLLO_EDGE_CONTROL_CERTIFICATE=./secrets/control-server-chain.pem
APOLLO_EDGE_CONTROL_PRIVATE_KEY=./secrets/control-server-key.pem
